# Copy to keystore.properties in this same folder. That file is gitignored.
# Do not put passwords in gradle.properties or in any tracked file.
# Environment variables override these values when set:
# TVDE_UPLOAD_STORE_FILE, TVDE_UPLOAD_STORE_PASSWORD,
# TVDE_UPLOAD_KEY_ALIAS, TVDE_UPLOAD_KEY_PASSWORD.
#
# Keep the upload keystore outside the repository, for example:
# C:\Users\frank\.android-keys\vamula\vamula-upload.p12
storeFile=
storePassword=
keyAlias=vamula-upload
keyPassword=
