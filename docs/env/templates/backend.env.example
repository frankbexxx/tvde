# Backend env template (copy → backend/.env locally)
# Nunca commitar backend/.env. Este ficheiro é seguro (sem secrets reais).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ride_db

JWT_SECRET_KEY=dev-jwt-secret-key-at-least-32-characters-long
OTP_SECRET=dev-otp-secret-key-at-least-32-characters-long

# dev | production (ou usa ENVIRONMENT)
ENV=dev
# ENVIRONMENT=production

# Seed/tokens em ambiente não-prod (ou explicitamente quando precisares)
ENABLE_DEV_TOOLS=true

# Produção: lista explícita (vírgulas; sem *)
CORS_ALLOWED_ORIGINS=https://tvde-app-j51f.onrender.com,http://localhost:5173

# Stripe — regra operacional: mock em piloto/dev (sem chaves Stripe no arranque).
# Nota código: o default em `config.py` se esta variável estiver ausente é `false`; define explicitamente.
STRIPE_MOCK=true
# Só preencher quando STRIPE_MOCK=false:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Rotacional v2 (opcional): mensagens extra no cabeçalho — JSON array de objetos {"text","source"} ou strings.
# ROTACIONAL_FEED_JSON=[{"text":"IPMA: aviso amarelo — aguaceiros na costa.","source":"meteo"}]

# Login Google (BETA) — OAuth 2.0 authorization code; redirect SPA = http://localhost:5173/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Piloto BETA (Render): LoginScreen + rate-limit pedidos
# BETA_MODE=true
# ADMIN_PHONE=+351...

# Cron externo (GET /cron/jobs?secret=…)
# CRON_SECRET=

# Sentry (lido em app/sentry.py via os.environ, não está no modelo Settings)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=

# --- Mais chaves opcionais (defaults em backend/app/core/config.py): ---
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_MINUTES=60
# OTP_EXPIRATION_MINUTES=5
# MAX_BETA_USERS=30
# ENABLE_CONFIRM_ON_ACCEPT=false
# GEO_RADIUS_KM=50
# OFFER_TIMEOUT_SECONDS=60
# OSRM_BASE_URL=
# DEBUG_RUNTIME_LOGS=false
# AUDIT_EVENTS_RETENTION_DAYS=90
# BASE_FARE / PRICE_PER_KM / PRICE_PER_MIN / CANCELLATION_* — pricing e taxas
# E2E_KEEP_OFFERS_ALIVE / E2E_OFFER_TIMEOUT_FLOOR_SECONDS — só CI / Playwright
