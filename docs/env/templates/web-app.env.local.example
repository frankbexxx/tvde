# Web App env template (copy → web-app/.env.local locally)
# Nunca commitar web-app/.env.local (pode conter keys).

# Playwright / CI apenas — nunca em build de produção
# VITE_E2E=true

# Default dev: proxy /api no Vite para http://localhost:8000
VITE_API_URL=/api

# Flags UX (opcionais)
VITE_DRIVER_BOTTOM_NAV=true
# Com barra inferior Manel activa, o fluxo em 2 passos é ignorado (ecrã único; toque «disponível» no mapa).
# Legacy sem bottom nav: definir VITE_DRIVER_HOME_TWO_STEP=true para mapa/disponibilidade + segundo ecrã com pedidos.
# VITE_DRIVER_HOME_TWO_STEP=false

# B3 (EXTRA): com barra inferior, o watch GPS só após o 1.º toque no mapa; alinhar com decisão #6.
VITE_DRIVER_GEO_ON_FIRST_MAP_TAP=true

# QR /dl e /app — URL externa opcional. Se vazio: landing interna /download (mesmo site).
# VITE_APP_DOWNLOAD_URL=https://…

# Mapas (opcional, mas recomendado para mapa/geocoding)
# VITE_MAPTILER_KEY=...

# Observabilidade (opcional)
# VITE_SENTRY_DSN=...
# VITE_SENTRY_RELEASE=...

# Stripe (frontend) — regra “mock por defeito”
VITE_STRIPE_MOCK=true
# Só preencher quando VITE_STRIPE_MOCK=false:
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

